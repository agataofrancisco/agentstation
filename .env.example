# Copiar para .env (nao commitar). Estas variaveis sao lidas do ambiente.
APP_ENV=dev
DEMO_MODE=true
DATABASE_URL=sqlite:///data/runtime/agentstation.db
CHECKPOINT_URL=sqlite:///data/runtime/checkpoints.db
# Para o checkpointer Postgres real: postgresql://user:pass@host:5432/db
# CHECKPOINT_URL=postgresql://postgres:@localhost:5432/agentstation
CELERY_BROKER_URL=filesystem://
CELERY_EAGER=false
JWT_SECRET=demo-only-insecure-secret-change-me
JWT_TTL_MINUTES=120
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
MAX_ITERATIONS=12
MAX_TOOL_CALLS=20
MAX_SECONDS=120
MAX_TOKENS=50000
MAX_COST_USD=0.5
MEMORY_TTL_DAYS=30
CHROMA_PATH=data/runtime/chroma
